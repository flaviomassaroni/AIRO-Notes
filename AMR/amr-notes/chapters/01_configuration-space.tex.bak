      \fill[pattern=north east lines, pattern color=orange!45] (0,0) rectangle (\S,\S);
      \draw[->, thick, blue!50!black] (-0.7,0) -- (\S+0.9,0) node[below] {$q_1$};
      \draw[->, thick, blue!50!black] (0,-0.7) -- (0,\S+0.9) node[left] {$q_2$};
      \draw[main] (0,0) -- (0,\S);
