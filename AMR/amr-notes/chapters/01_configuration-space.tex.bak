      \node[pt, font=\small, right=4pt] at (P2) {$(\bar q_1{+}2\pi,\bar q_2)$};
      \draw[decorate, decoration={brace, amplitude=6pt}, blue!50!black]
            ($(P1)+(0,0.35)$) -- ($(P2)+(0,0.35)$)
            node[midway, above=7pt] {$2\pi$};
      \node[note] at (\ox+2.9,3.2)
            {these two points correspond\\to the same posture};
      \node[note] at (\ox+2.9,2.55) {$\Rightarrow$ \textbf{not injective}};

      % ---- arcs: arm angle  ->  points of the plane
      \draw[->, main] (0.85,-0.05) to[out=-80, in=-125] (P1);
      \draw[->, main] (0.55,-0.05) to[out=-85, in=-105, looseness=1.5] (P2);
      \node[note] at (4.8,-3.1) {every point\\represents a posture};
    \end{tikzpicture}}
    \caption{The planar 2R arm and its $(q_1,q_2)$ plane. Every point of the
    plane is a posture, but $(\bar q_1,\bar q_2)$ and
    $(\bar q_1+2\pi,\bar q_2)$ are different points describing the
    \emph{same} posture: the parameterization is not injective.}
    \label{fig:cspace-arm-equivalence}
\end{figure}

\subsection{Non-Injectivity of the Parameterization}
\label{subsec:cspace-non-injective}

Angles are periodic with period \( 2\pi \): rotating a joint by a full
turn leaves the arm exactly where it was. The points
\( (\bar q_1, \bar q_2) \) and \( (\bar q_1 + 2\pi, \bar q_2) \) of
\cref{fig:cspace-arm-equivalence} are therefore \emph{different points
describing the same posture}. Formally, the map
\[
\Phi : \mathbb{R}^2 \to \mathcal{T}^2, \qquad
\Phi(q_1, q_2) = (q_1 \bmod 2\pi,\ q_2 \bmod 2\pi),
\]
is \emph{surjective but not injective}: two points have the same image
if and only if they differ by integer multiples of \( 2\pi \) in each
coordinate,
\[
(q_1, q_2) \sim (q_1 + 2\pi k_1,\ q_2 + 2\pi k_2),
\qquad k_1, k_2 \in \mathbb{Z},
\]
so every posture has infinitely many representatives in the plane.
Restricting to the closed square \( [0, 2\pi] \times [0, 2\pi] \) is not
enough: opposite edges are still pairwise identified,
\( (q_1, 0) \sim (q_1, 2\pi) \) and \( (0, q_2) \sim (2\pi, q_2) \), and
the four corners all represent the same posture.

\subsection{Restoring Injectivity: the Fundamental Domain}
\label{subsec:cspace-fundamental-domain}

To remove the redundancy it is enough to keep one representative per
class. The standard choice is the half-open square
\[
[0, 2\pi) \times [0, 2\pi) \subset \mathbb{R}^2,
\]
called the \emph{fundamental domain}: the left and bottom edges belong to
\( C \), while the top and right edges do not (dashed in
\cref{fig:cspace-torus-square}, left). With this choice \( \Phi \)
becomes a \emph{bijection}: for each configuration in the square there
is one and only one posture, and every posture appears exactly once.
This is why the fundamental domain is usually written as a half-open
square.

