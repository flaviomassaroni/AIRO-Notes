      % ---- the arm
      \draw[->, gray] (-0.5,0) -- (3.9,0);
      \draw[->, gray] (0,-0.5) -- (0,3.2);
      \coordinate (E) at (\tha:\lone);
      \coordinate (T) at ($(E)+({\tha+\thb}:\ltwo)$);
      \draw[main] (0,0) -- (E) -- (T);
      \draw[main, dashed, thin] (E) -- ($(E)+(\tha:0.8)$);
      \fill[white, draw=blue!50!black, thick] (0,0) circle (3pt);
      \fill[white, draw=blue!50!black, thick] (E) circle (3pt);
      \fill[blue!50!black] (T) circle (2.5pt);
