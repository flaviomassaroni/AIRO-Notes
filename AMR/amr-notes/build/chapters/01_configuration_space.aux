\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Gluing the opposite sides of the square: identifying $q_1=0\equiv 2\pi $ (red) gives a cylinder, identifying $q_2=0\equiv 2\pi $ (blue) closes it into a torus $\mathcal  {T}^2=\mathcal  {S}^1\times \mathcal  {S}^1$. The points $q_1=\varepsilon $ and $q_1=2\pi -\varepsilon $, far apart in the square, are now neighbours on either side of the seam: the torus respects the topology of $C$. Configuration spaces are in general manifolds (angular coordinates).}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cspace-torus-3d}{{2.3}{11}{Gluing the opposite sides of the square: identifying $q_1=0\equiv 2\pi $ (red) gives a cylinder, identifying $q_2=0\equiv 2\pi $ (blue) closes it into a torus $\mathcal {T}^2=\mathcal {S}^1\times \mathcal {S}^1$. The points $q_1=\varepsilon $ and $q_1=2\pi -\varepsilon $, far apart in the square, are now neighbours on either side of the seam: the torus respects the topology of $C$. Configuration spaces are in general manifolds (angular coordinates)}{figure.caption.10}{}}
\newlabel{fig:cspace-torus-3d@cref}{{[figure][3][2]2.3}{[1][10][]11}{}{}{}}
