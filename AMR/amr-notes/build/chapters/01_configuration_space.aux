\newlabel{subsec:cspace-fundamental-domain@cref}{{[subsection][3][2,5]2.5.3}{[1][9][]9}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5.4}The Remaining Problem: Closeness Is Not Preserved}{9}{subsection.2.5.4}\protected@file@percent }
\newlabel{subsec:cspace-closeness}{{2.5.4}{9}{The Remaining Problem: Closeness Is Not Preserved}{subsection.2.5.4}{}}
\newlabel{subsec:cspace-closeness@cref}{{[subsection][4][2,5]2.5.4}{[1][9][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Left: the half-open square $[0,2\pi )\times [0,2\pi )$ (dashed sides excluded) gives exactly one point per posture, so the representation is injective. Right: two points at opposite sides of the square are far apart in the plane but describe almost the same posture, so the square does not respect the topology of $C$.}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cspace-torus-square}{{2.2}{10}{Left: the half-open square $[0,2\pi )\times [0,2\pi )$ (dashed sides excluded) gives exactly one point per posture, so the representation is injective. Right: two points at opposite sides of the square are far apart in the plane but describe almost the same posture, so the square does not respect the topology of $C$}{figure.caption.9}{}}
\newlabel{fig:cspace-torus-square@cref}{{[figure][2][2]2.2}{[1][9][]10}{}{}{}}
