\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces The planar 2R arm and its $(q_1,q_2)$ plane. Every point of the plane is a posture, but $(\bar  q_1,\bar  q_2)$ and $(\bar  q_1+2\pi ,\bar  q_2)$ are different points describing the \emph  {same} posture: the parameterization is not injective.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cspace-arm-equivalence}{{2.1}{9}{The planar 2R arm and its $(q_1,q_2)$ plane. Every point of the plane is a posture, but $(\bar q_1,\bar q_2)$ and $(\bar q_1+2\pi ,\bar q_2)$ are different points describing the \emph {same} posture: the parameterization is not injective}{figure.caption.8}{}}
\newlabel{fig:cspace-arm-equivalence@cref}{{[figure][1][2]2.1}{[1][8][]9}{}{}{}}
