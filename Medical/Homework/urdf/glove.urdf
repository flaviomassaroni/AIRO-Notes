<?xml version="1.0"?>
<robot name="hand_3r_glove">

  <!-- ==================== DICHIARAZIONE MATERIALI GLOBALI ==================== -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.9 0.9 0.1 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.9 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.9 0.1 1.0"/>
  </material>

  <!-- PALMO (Base di ancoraggio rigida del guanto) -->
  <link name="palm_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== DITO INDICE (Catena 3R, X = 0.03) ==================== -->
  <link name="index_proximal_link">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.008"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000003" ixy="0.0" ixz="0.0" iyy="0.000003" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="index_mcp_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="index_proximal_link"/>
    <origin xyz="0.03 0.0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="5.0" lower="0.0" upper="1.57" velocity="1.5"/>
  </joint>

  <link name="index_middle_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.0000005"/>
    </inertial>
  </link>

  <joint name="index_pip_joint" type="revolute">
    <parent link="index_proximal_link"/>
    <child link="index_middle_link"/>
    <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="3.0" lower="0.0" upper="1.74" velocity="2.0"/>
  </joint>

  <link name="index_distal_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.006"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" iyy="0.0000005" iyz="0.0" izz="0.0000002"/>
    </inertial>
  </link>

  <joint name="index_dip_joint" type="revolute">
    <parent link="index_middle_link"/>
    <child link="index_distal_link"/>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="2.0" lower="0.0" upper="1.39" velocity="2.5"/>
  </joint>

  <!-- ==================== DITO MEDIO (Catena 3R, X = 0.01) ==================== -->
  <link name="middle_proximal_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.0085"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.0085"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.022"/>
      <inertia ixx="0.000004" ixy="0.0" ixz="0.0" iyy="0.000004" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="middle_mcp_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="middle_proximal_link"/>
    <origin xyz="0.01 0.0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="5.0" lower="0.0" upper="1.57" velocity="1.5"/>
  </joint>

  <link name="middle_middle_link">
    <visual>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.0075"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.0075"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.017"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.0000006"/>
    </inertial>
  </link>

  <joint name="middle_pip_joint" type="revolute">
    <parent link="middle_proximal_link"/>
    <child link="middle_middle_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="3.0" lower="0.0" upper="1.74" velocity="2.0"/>
  </joint>

  <link name="middle_distal_link">
    <visual>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.006"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.011"/>
      <inertia ixx="0.0000006" ixy="0.0" ixz="0.0" iyy="0.0000006" iyz="0.0" izz="0.0000002"/>
    </inertial>
  </link>

  <joint name="middle_dip_joint" type="revolute">
    <parent link="middle_middle_link"/>
    <child link="middle_distal_link"/>
    <origin xyz="0.0 0.0 0.035" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="2.0" lower="0.0" upper="1.39" velocity="2.5"/>
  </joint>

  <!-- ==================== DITO ANULARE (Catena 3R, X = -0.01) ==================== -->
  <link name="ring_proximal_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.0085"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.0085"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.022"/>
      <inertia ixx="0.000004" ixy="0.0" ixz="0.0" iyy="0.000004" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="ring_mcp_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="ring_proximal_link"/>
    <origin xyz="-0.01 0.0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="5.0" lower="0.0" upper="1.57" velocity="1.5"/>
  </joint>

  <link name="ring_middle_link">
    <visual>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.0075"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.0075"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.017"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.0000006"/>
    </inertial>
  </link>

  <joint name="ring_pip_joint" type="revolute">
    <parent link="ring_proximal_link"/>
    <child link="ring_middle_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="3.0" lower="0.0" upper="1.74" velocity="2.0"/>
  </joint>

  <link name="ring_distal_link">
    <visual>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.006"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.011"/>
      <inertia ixx="0.0000006" ixy="0.0" ixz="0.0" iyy="0.0000006" iyz="0.0" izz="0.0000002"/>
    </inertial>
  </link>

  <joint name="ring_dip_joint" type="revolute">
    <parent link="ring_middle_link"/>
    <child link="ring_distal_link"/>
    <origin xyz="0.0 0.0 0.035" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="2.0" lower="0.0" upper="1.39" velocity="2.5"/>
  </joint>

  <!-- ==================== DITO MIGNOLO (Catena 3R, X = -0.03) ==================== -->
  <link name="pinky_proximal_link">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.008"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000003" ixy="0.0" ixz="0.0" iyy="0.000003" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="pinky_mcp_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="pinky_proximal_link"/>
    <origin xyz="-0.03 0.0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="5.0" lower="0.0" upper="1.57" velocity="1.5"/>
  </joint>

  <link name="pinky_middle_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.0000005"/>
    </inertial>
  </link>

  <joint name="pinky_pip_joint" type="revolute">
    <parent link="pinky_proximal_link"/>
    <child link="pinky_middle_link"/>
    <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="3.0" lower="0.0" upper="1.74" velocity="2.0"/>
  </joint>

  <link name="pinky_distal_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.006"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000005" ixy="0.0" ixz="0.0" iyy="0.0000005" iyz="0.0" izz="0.0000002"/>
    </inertial>
  </link>

  <joint name="pinky_dip_joint" type="revolute">
    <parent link="pinky_middle_link"/>
    <child link="pinky_distal_link"/>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="2.0" lower="0.0" upper="1.39" velocity="2.5"/>
  </joint>

  <!-- ==================== POLLICE (Catena 2R sul piano radiale) ==================== -->
  <link name="thumb_proximal_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.000004" ixy="0.0" ixz="0.0" iyy="0.000004" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Giunto CMC del pollice (opposizione sul piano trasversale) -->
  <joint name="thumb_cmc_joint" type="revolute">
    <parent link="palm_link"/>
    <child link="thumb_proximal_link"/>
    <origin xyz="0.04 0.0 0.03" rpy="0 -0.52 0.78"/> <!-- Orientamento biologico inclinato -->
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-0.52" upper="1.05" velocity="1.5"/>
  </joint>

  <link name="thumb_distal_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.008"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.015"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.0000006"/>
    </inertial>
  </link>

  <joint name="thumb_mcp_joint" type="revolute">
    <parent link="thumb_proximal_link"/>
    <child link="thumb_distal_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="3.0" lower="0.0" upper="1.57" velocity="2.0"/>
  </joint>

</robot>